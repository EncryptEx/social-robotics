# Copy to .env and choose your own local Neo4j password (8+ characters).
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-your-own-password

# Cohere extracts facts, creates dialogue, and describes one camera frame.
# Never commit a real API key.
COHERE_API_KEY=replace-with-your-cohere-api-key
COHERE_TEXT_MODEL=command-a-03-2025
COHERE_VISION_MODEL=command-a-vision-07-2025
